# Python, environments, test/build caches
__pycache__/
*.py[cod]
*$py.class
.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local configuration and credentials; anpr.example.yaml stays in Git
/anpr.yaml
/anpr.local.yaml
/anpr.*.local.yaml
.env
.env.*
!.env.example
*.key
*.pem
cam*url*.txt
cam*.url

# Local records, camera history, snapshots, videos and evaluation datasets
/data/*
!/data/vehicles_example.csv
!/data/README.md
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.log

# Keep unapproved models and binaries local; approved runtime weights are listed below
/weights/*
!/weights/README.md
!/weights/manifest.json
*.pt
*.pth
*.onnx
*.engine
*.trt
*.npy
*.npz
*.mp4
*.avi
*.mkv
*.mov
*.whl
*.dll
*.pyd
*.so
*.exe
*.zip
*.7z
*.tar
*.tar.gz

# Runtime models travel with a normal clone, without Git LFS
!/weights/yolo26n.pt
!/weights/ru_plate/
/weights/ru_plate/*
!/weights/ru_plate/plate_detector.pt
!/weights/ru_plate/plate_recognizer.pt

# Editor, local diagnostics and OS files
.idea/
.vscode/
/work/
/outputs/
/logs/
*.tmp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
